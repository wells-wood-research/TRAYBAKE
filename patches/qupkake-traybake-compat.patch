+def _find_xtb_error(error):
+    """Return an XTBError from an exception chain, if present."""
+    seen = set()
+    while error is not None and id(error) not in seen:
+        if isinstance(error, XTBError):
+            return error
+        seen.add(id(error))
+        error = error.__cause__ or error.__context__
+    return None
+
