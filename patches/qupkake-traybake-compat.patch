+DEFAULT_SCF_ITERATIONS = 1000
+_XTB_LOG_COUNTER = count()
+
+
+def _xtb_options(options: str) -> list[str]:
+    """Apply QupKake's default SCF iteration limit unless explicitly set."""
+    arguments = options.split()
+    if not any(
+        argument == "--iterations" or argument.startswith("--iterations=")
+        for argument in arguments
+    ):
+        arguments.extend(("--iterations", str(DEFAULT_SCF_ITERATIONS)))
+    return arguments
+
+
+def _xtb_log_paths(directory: str) -> tuple[str, str]:
+    """Return unique persistent stdout and stderr paths for one xTB run."""
+    prefix = f"xtb-{os.getpid()}-{next(_XTB_LOG_COUNTER):04d}"
+    return (
+        os.path.join(directory, f"{prefix}.stdout.log"),
+        os.path.join(directory, f"{prefix}.stderr.log"),
+    )
+
+
+class XTBError(RuntimeError):
+    """Raised when an xTB calculation or its output parsing fails."""
+
